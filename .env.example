# Copy to .env at the repo root and adjust as needed. Never commit .env.

# Postgres used by apps/api (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://launchpad:launchpad@localhost:5442/launchpad?schema=public"

# Optional override for tests. Default is the db-test service on port 5443.
# TEST_DATABASE_URL="postgresql://launchpad:launchpad@localhost:5443/launchpad_test?schema=public"

# apps/api
NODE_ENV=development
# The API's port. If you change it, change API_INTERNAL_URL at the bottom to match.
PORT=4100

# Better Auth. Generate a secret per environment and never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The web app's public URL (the browser only talks to Next). Must be https in production.
BETTER_AUTH_URL=http://localhost:3100
# Proxies in front of the API that append to X-Forwarded-For. Locally Next passes the header
# through without adding a hop, so 1 is right here and behind a single platform proxy.
TRUST_PROXY_HOPS=1

# Key that encrypts each user's saved Claude API key (AES-256-GCM, exactly 32 bytes, base64).
# Generate one per environment and back it up: losing it means every user re-enters their key.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=
CREDENTIAL_KEY_VERSION=1
# How long one Claude call may take before the API gives up, in milliseconds.
ANTHROPIC_TIMEOUT_MS=90000

# How verification and password-reset links are delivered. "console" prints the link in the API
# terminal and is for development only. Production refuses to start with it.
MAIL_TRANSPORT=console

# apps/web: server components and Next rewrites call Express here. Not exposed to the browser.
# Next keeps the rewrite when the web app is built, so set this before `npm run build` too, not
# only when the web app starts.
API_INTERNAL_URL=http://localhost:4100
