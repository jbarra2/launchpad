# Copy to .env at the repo root and adjust as needed. Never commit .env.

# Postgres used by apps/api (matches docker-compose.yml, which `npm run db:up` starts)
DATABASE_URL="postgresql://launchpad:launchpad@localhost:5442/launchpad?schema=public"

# Optional override for tests. Default is the db-test service on port 5443, which
# `npm run db:test:up` starts. Tests never touch DATABASE_URL.
# TEST_DATABASE_URL="postgresql://launchpad:launchpad@localhost:5443/launchpad_test?schema=public"

# apps/api
NODE_ENV=development
# The API's port. If you change it, change API_INTERNAL_URL at the bottom to match.
PORT=4100

# Better Auth. The API will not start without a secret of at least 32 characters. Generate one per
# environment and never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The web app's public URL (the browser only talks to Next), with no path. Links in emails start
# from it. Must be https in production.
BETTER_AUTH_URL=http://localhost:3100
# How many proxies in front of the API add their own address to X-Forwarded-For. Next adds none, so
# 0 is right on a laptop. Behind one platform proxy in front of the web app, use 1. A number that is
# too high lets a client choose the address that the sign-in rate limits count.
TRUST_PROXY_HOPS=0

# Key that encrypts each user's saved Claude API key (AES-256-GCM, exactly 32 bytes, base64).
# Generate one per environment and back it up: losing it means every user re-enters their key.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=
CREDENTIAL_KEY_VERSION=1
# How long one Claude call may take before the API gives up, in milliseconds.
ANTHROPIC_TIMEOUT_MS=90000

# How verification and password-reset links are delivered. "console" prints the link in the API
# terminal and is for development only, because a link is a way into an account. Production
# refuses to start with it.
MAIL_TRANSPORT=console

# apps/web: server components and Next rewrites call Express here. Not exposed to the browser.
# Next keeps the rewrite when the web app is built, so set this before `npm run build` too, not
# only when the web app starts.
API_INTERNAL_URL=http://localhost:4100
